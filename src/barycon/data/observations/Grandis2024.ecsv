# ---
# datatype:
# - {name: name, datatype: string}
# - {name: mass_proxy, datatype: string}
# - {name: mass_proxy_details, datatype: string}
# - {name: M_500c, unit: 1e+14 solMass, datatype: float64}
# - {name: f_gas, datatype: float64}
# - {name: f_gas_lo, datatype: float64}
# - {name: f_gas_hi, datatype: float64}
# - {name: f_star, datatype: float64}
# - {name: f_star_lo, datatype: float64}
# - {name: f_star_hi, datatype: float64}
# - {name: slope_f_gas, datatype: float64}
# - {name: slope_f_gas_lo, datatype: float64}
# - {name: slope_f_gas_hi, datatype: float64}
# - {name: slope_f_star, datatype: float64}
# - {name: slope_f_star_lo, datatype: float64}
# - {name: slope_f_star_hi, datatype: float64}
# meta: !!omap
# - {kind: observation}
# - {extracted: false}
# - {status: needs_check}
# - contributors: ["G. Aric\xF2", M. Douspis]
# - {added: '2026-11-06'}
# - caveats: ['each survey row was derived under its own cosmology: check whether Grandis+24 homogenised', duplicates information in Chiu2018
#       and Akino2022 -> do not fit jointly, one point per survey at the pivot mass; slope_* columns give the local logarithmic slope,
#     WtG row has no error and no slope, IMF to be recorded]
# - changelog: []
# - {id: Grandis2024}
# - {reference: 'Grandis, S., et al. 2024, MNRAS (compilation in their Table 1), arXiv:2309.02920'}
# - {bibcode: null}
# - {doi: 10.1093/mnras/stae259}
# - {arxiv: '2309.02920'}
# - {url: 'https://arxiv.org/abs/2309.02920'}
# - {description: 'Compilation of gas and stellar fractions at the pivot mass of power-law fits from SPT (Chiu+18), eFEDS, HSC-XXL (Akino+22)
#     and WtG, with the local logarithmic slope.'}
# - {data_type: points}
# - quantities: [f_gas, f_star]
# - aperture: {delta: 500c, r_inner: null, r_outer: 1.0, region: sphere}
# - mass: {column: M_500c, definition: 500c, distance_exponent: 1.0, proxy: mixed, proxy_details: 'differs per survey: see the mass_proxy
#       column', unit: Msun}
# - cosmology: {H0: 67.0, Ode0: 0.7, Om0: 0.3, note: 'VERIFY: legacy used h=0.67 for all rows'}
# - stellar: {imf: null, includes_bcg: true, includes_icl: false}
# - redshift: {effective: 0.3, max: 1.3, min: 0.0}
# - {table_source: Table 1}
# - overlaps_with: [Chiu2018, Akino2022, Mantz2022]
# schema: astropy-2.0
name mass_proxy mass_proxy_details M_500c f_gas f_gas_lo f_gas_hi f_star f_star_lo f_star_hi slope_f_gas slope_f_gas_lo slope_f_gas_hi slope_f_star slope_f_star_lo slope_f_star_hi
SPT sz_scaling_relation "SPT SZ (Chiu+18)" 4.8 0.12 0.01 0.01 0.008 0.001 0.001 0.33 0.09 0.09 -0.2 0.12 0.12
eFEDS xray_scaling_relation "count-rate-mass relation, WL calibrated" 2.0 0.05 0.01 0.01 nan nan nan 0.19 0.11 0.11 nan nan nan
HSCXXL weak_lensing "HSC weak lensing (Akino+22)" 1.0 0.08 0.01 0.01 0.021 0.003 0.003 0.23 0.12 0.12 -0.2 0.11 0.11
WtG weak_lensing "Weighing the Giants weak lensing" 10.0 0.12 nan nan nan nan nan nan nan nan nan nan nan
